#!/usr/bin/env bash
# pi-mlx — the SIA offline meta/feedback engine: read a prompt on stdin and
# generate a completion locally with mlx-lm-generate, writing it to stdout.
#
# This is the whole of the "fully offline" path (spec docs/specs/02-pi.md): the
# SIA ExecRunner writes the prompt to this script's stdin and runs it in the
# generation's working directory; the script shells out to mlx-lm-generate so
# the loop runs with no network and no in-process model dependency.
#
# Default model: mlx-community/Llama-3.2-1B-Instruct-4bit — a 4-bit Llama that
# loads in ~0.3s and is already cached, fast enough to keep the loop watchable.
# (The cached Qwen2.5 family does NOT load in this mlx-lm-generate build:
# "unknown model family qwen2"; the llama family is registered.) Override with
# PI_MLX_MODEL for a smarter run, e.g. mlx-community/Llama-3.2-3B-Instruct-4bit
# — but that model is not pre-cached and auto-downloads (~1.7 GiB) on first use,
# so keep the default for a network-free demo.
#
# Environment:
#   PI_MLX_MODEL    model id or path        (default mlx-community/Llama-3.2-1B-Instruct-4bit)
#   PI_MLX_MAXTOK   max generated tokens    (default 2048)
#   PI_MLX_TEMP     sampling temperature    (unset → mlx-lm-generate default)
# Extra args after `--` are passed through to mlx-lm-generate verbatim.
set -euo pipefail

model="${PI_MLX_MODEL:-mlx-community/Llama-3.2-1B-Instruct-4bit}"
maxtok="${PI_MLX_MAXTOK:-2048}"
prompt="$(cat)" # ExecRunner writes the SIA prompt to stdin.

args=(-model "$model" -max-tokens "$maxtok" -q -prompt "$prompt")
if [[ -n "${PI_MLX_TEMP:-}" ]]; then
	args+=(-temp "$PI_MLX_TEMP")
fi

exec mlx-lm-generate "${args[@]}" "$@"
